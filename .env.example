# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public URL of the admin/frontend (used for cookies + CORS in dev)
ADMIN_ORIGIN=http://localhost:5173

# Database (MySQL)
DATABASE_URL=mysql://root@localhost:3306/pixellize_cms

# Auth
# Generate a long random value: `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_COOKIE_NAME=pcms_session
# Session lifetime in days
SESSION_TTL_DAYS=7

# Media storage (local filesystem)
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_PATH=/uploads
MAX_UPLOAD_MB=10

# Shared secret for cron-triggered scheduled publishing (optional).
# Set this and call: curl -H "x-cron-secret: <value>" -X POST <host>/api/cron/publish-scheduled
# CRON_SECRET=change-me
