{
  "name": "@pixellize/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "push": "drizzle-kit push",
    "seed": "tsx src/seed.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pixellize/core": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
