{
  "name": "@pixellize/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "vite build --outDir ../server/public/site --emptyOutDir",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir ../server/ssr --emptyOutDir",
    "build": "pnpm build:client && pnpm build:server",
    "dev": "pnpm build:client -- --watch & pnpm build:server -- --watch & wait",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
